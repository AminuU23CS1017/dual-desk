# Optional outbound signal delivery. Configure these as Sites secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated authenticated user IDs permitted to send to your private group.
TELEGRAM_ALLOWED_USER_IDS=
# Live trade execution is intentionally unavailable in this first version.

# Verified sign-in emails allowed to send; alternative to site-specific user IDs.
TELEGRAM_ALLOWED_EMAILS=

# Deriv OAuth token encryption and exact site origin. Never publish the real key.
BROKER_TOKEN_KEY=
BROKER_SITE_ORIGIN=
# Broker setup is restricted to the same approved IDs/emails listed above.
